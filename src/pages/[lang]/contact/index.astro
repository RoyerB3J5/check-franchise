---
import Liston from "../../../components/Liston.astro";
import en from "../../../i18n/en";
import es from "../../../i18n/es";
import Layout from "../../../layouts/Layout.astro";

import type { Language } from "../../../types/language.type";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

export const defaultRedirect = "/en";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
const seo = t.seo.contact;
const content = t.contact;
---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/contact"
>
  <section class='relative flex w-full items-center justify-center'>
    <Liston
    src="/images/decoration-l.webp"
    w={115} h={411}
    d="M -20 88 C 45 88, 125 180, 100 245 C 80 300, 45 348, -20 348"
    grosor={120}
    class="absolute bottom-[10%] left-0 w-[115px] h-auto z-10"
  />
  <Liston src="/images/decoration-o-r.webp" w={284} h={656} grosor={230} d="M 330 700 C 303 640, 280 573, 250 520 C 220 467, 178 425, 150 380 C 122 335, 93 288, 80 250 C 67 212, 63 176, 70 150 C 77 124, 98 103, 120 95 C 142 87, 173 91, 200 100 C 227 109, 257 135, 284 150 C 311 165, 335 177, 360 190" class="absolute top-[20%] right-0 w-[153px] h-auto object-cover z-10" />
    <div class='container-full relative z-5 flex items-center justify-center gap-20 py-25 text-paragraph lg:grid lg:grid-cols-2 lg:items-start'>
      <div data-contact-map class='relative h-auto w-[50%] aspect-688/530 overflow-hidden rounded-lg lg:w-full'>
        <img src='/images/map.webp' alt='Map' decoding="async" loading="eager" fetchpriority="high" width="688" height="530" class='absolute inset-0 h-full w-full object-cover' />
      </div>
      <div data-contact-copy class='flex w-[50%] flex-col items-center justify-center gap-40 lg:w-full bg-white'>
          <div class=' flex flex-col justify-center items-start gap-18 text-paragraph w-full'> 
            <h2 class='heading-1' set:html={content.location.title}></h2>
            {
              content.location.info.map((item)=>(
                <div class='flex flex-col justify-center items-start gap-8'>
                  <h3 class='body-md'>{item.description}</h3>
                  <a href={item.link} class='body-xl hover:text-secondary' set:html={item.title}></a>
                </div>
              ))
            }
          </div>
        <div class='w-full flex flex-col justify-center items-start gap-10 text-paragraph'>
          <h2 class='heading-1' set:html={content.location.yourBusiness.title2}></h2>
          <p class='body-md'>
            {content.location.yourBusiness.description}
          </p>
        </div>  
      </div> 
    </div>
  </section>
</Layout>

<style>
  @media (min-width: 1024px) {
    [data-contact-map] {
      position: sticky;
      top: 50px;
      opacity: 0;
      animation: contact-map-reveal 1.4s ease-out 350ms both;
    }

    [data-contact-copy] {
      animation: contact-copy-arrive 1.6s cubic-bezier(0.22, 1, 0.36, 1) 200ms both;
      will-change: transform;
    }

    @keyframes contact-copy-arrive {
      from {
        transform: translateX(calc(-100% - 5rem));
      }

      to {
        transform: translateX(0);
      }
    }

    @keyframes contact-map-reveal {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-contact-map],
    [data-contact-copy] {
      animation: none !important;
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
</style>

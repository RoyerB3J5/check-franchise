---
import FormContact from "../../../components/FormContact.astro";
import Liston from "../../../components/Liston.astro";
import en from "../../../i18n/en";
import es from "../../../i18n/es";
import Layout from "../../../layouts/Layout.astro";

import type { Language } from "../../../types/language.type";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

export const defaultRedirect = "/en";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
const seo = t.seo.contact;
const content = t.contact;
---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/contact"
>
  <section class='relative flex w-full items-center justify-center'>
    <Liston
    src="/images/decoration-l.webp"
    w={115} h={411}
    d="M -20 88 C 45 88, 125 180, 100 245 C 80 300, 45 348, -20 348"
    grosor={120}
    class="absolute bottom-[10%] left-0 w-[115px] h-auto z-10"
  />
  <Liston src="/images/decoration-o-r.webp" w={284} h={656} grosor={230} d="M 360 190 C 335 177, 311 165, 284 150 C 257 135, 227 109, 200 100 C 173 91, 142 87, 120 95 C 98 103, 77 124, 70 150 C 63 176, 67 212, 80 250 C 93 288, 122 335, 150 380 C 178 425, 220 467, 250 520 C 280 573, 303 640, 330 700" class="absolute top-[20%] right-0 w-[153px] h-auto object-cover z-10" />
    <div class='container-full relative z-5 flex flex-col md:flex-row items-center justify-center gap-14 md:gap-20 py-14 md:py-20 xl:py-25 text-paragraph lg:grid lg:grid-cols-2 md:items-start'>
      <div data-contact-map class='contact-mobile-animation fade-left-a relative h-auto w-full md:w-[50%] aspect-151/122 md:aspect-688/530 overflow-hidden rounded-lg lg:w-full'>
        <img src='/images/map.webp' alt='Map' decoding="async" loading="eager" fetchpriority="high" width="688" height="530" class='absolute inset-0 h-full w-full object-cover' />
      </div>
      <div data-contact-copy class='flex w-full md:w-[50%] flex-col items-center justify-center gap-14 md:gap-40 lg:w-full bg-white'>
          <div class='flex flex-col justify-center items-start gap-10 md:gap-18 text-paragraph w-full'>
            <h2 class='contact-mobile-animation heading-1 fade-up-lines' set:html={content.location.title}></h2>
            {
              content.location.info.map((item)=>(
                <div class='contact-mobile-animation fade-up-a flex flex-col justify-center items-start gap-8'>
                  <h3 class='contact-mobile-animation body-md fade-up-lines'>{item.description}</h3>
                  <a href={item.link} class='body-xl hover:text-secondary' set:html={item.title}></a>
                </div>
              ))
            }
          </div>
        <div class='w-full flex flex-col justify-center items-start gap-10 text-paragraph'>
          <h2 class='contact-mobile-animation heading-1 fade-up-lines' set:html={content.location.yourBusiness.title2}></h2>
          <p class='contact-mobile-animation body-md fade-up-lines'>
            {content.location.yourBusiness.description}
          </p>
          <FormContact />
        </div>  
      </div> 
    </div>
  </section>
</Layout>

<style>
  @media (min-width: 768px) {
    [data-contact-map] {
      position: sticky;
      top: 50px;
      opacity: 0;
      animation: contact-map-reveal 1.4s ease-out 350ms both;
    }

    [data-contact-copy] {
      animation: contact-copy-arrive 1.6s cubic-bezier(0.22, 1, 0.36, 1) 200ms both;
      will-change: transform;
    }

    @keyframes contact-copy-arrive {
      from {
        transform: translateX(calc(-100% - 5rem));
      }

      to {
        transform: translateX(0);
      }
    }

    @keyframes contact-map-reveal {
      from {
        opacity: 0;
      }

      to {
        opacity: 1;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-contact-map],
    [data-contact-copy] {
      animation: none !important;
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }

  @media (min-width: 768px) {
    .contact-mobile-animation.fade-up-a,
    .contact-mobile-animation.fade-left-a {
      opacity: 1;
      animation: none;
      transform: none;
    }

    .contact-mobile-animation.fade-up-lines,
    .contact-mobile-animation.fade-up-lines :global(.fade-up-line-fragment),
    .contact-mobile-animation.fade-up-lines :global(.fade-up-line-word) {
      transform: none;
      transition: none;
    }
  }
</style>

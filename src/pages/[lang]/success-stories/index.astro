---
import en from "../../../i18n/en";
import es from "../../../i18n/es";
import Layout from "../../../layouts/Layout.astro";
import HeroBanner from "../../../sections/HeroBanner.astro";
import ReviewContent from "../../../components/ReviewContent.astro";
import type { Language } from "../../../types/language.type";
import Call from "../../../sections/Call.astro";
import Cases from "../../../sections/Cases.astro";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

export const defaultRedirect = "/en";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
const seo = t.seo.successStories;
---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/success-stories"
>
  <HeroBanner content={t.caseSuccess.hero} />
  <section class='flex justify-center items-center bg-[#F3F0E9] w-full'>
    <div class=' py-14 md:py-20 lg:py-25 container-full flex justify-center items-center '>
      <ReviewContent content={t.main.review} />
    </div>
  </section>  
  <Cases content={t.caseSuccess.cases} />
  <Call content={t.caseSuccess.next} />
</Layout>

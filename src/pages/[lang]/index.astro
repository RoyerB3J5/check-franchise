---
import en from "../../i18n/en";
import es from "../../i18n/es";
import Layout from "../../layouts/Layout.astro";
import Banner from "../../sections/Main/Banner.astro";
import Branchs from "../../sections/Main/Branchs.astro";
import BreakPoint from "../../sections/Main/BreakPoint.astro";
import Cifras from "../../sections/Main/Cifras.astro";
import Consultors from "../../sections/Main/Consultors.astro";
import Founder from "../../sections/Main/Founder.astro";
import Hero from "../../sections/Main/Hero.astro";
import Pilars from "../../sections/Main/Pilars.astro";
import Questions from "../../sections/Main/Questions.astro";
import Reviews from "../../sections/Main/Reviews.astro";

import type { Language } from "../../types/language.type";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

export const defaultRedirect = "/en";

const lang = Astro.params.lang as Language;
const translations = { es, en };
const t = translations[lang];
const seo = t.seo.main;
---

<Layout
  lang={lang}
  t={t}
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  canonicalPath="/"
>
  <Hero content={t.main.hero} />
  
  <Cifras content={t.main.cifras} />
  <BreakPoint content={t.main.breakPoint} />
  <Pilars content={t.main.pilars} />
  <Consultors content={t.main.consultors} />
  <Branchs content={t.main.portfolio} />
  <Reviews content={t.main.review} />
  <Founder content={t.main.founder} />
  <Banner content={t.main.banner} />
  <Questions content={t.main.questions} />
</Layout>

<script>
  import { initGlobalScrollSnap } from "../../lib/scrollSnapper";

  let cleanupScrollSnap: (() => void) | undefined;

  const initializeScrollSnap = () => {
    cleanupScrollSnap?.();
    cleanupScrollSnap = initGlobalScrollSnap();
  };

  const teardownScrollSnap = () => {
    cleanupScrollSnap?.();
    cleanupScrollSnap = undefined;
  };

  document.addEventListener("astro:before-swap", teardownScrollSnap);
  document.addEventListener("astro:page-load", initializeScrollSnap);

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeScrollSnap, { once: true });
  } else {
    initializeScrollSnap();
  }
</script>

---
type Translations = typeof import("../i18n/en").default;
type Content = Translations["main"]["review"];
interface Props {
  content: Content;
}
const { content} = Astro.props as Props;

// Comprueba si la URL coincide con la raíz o los prefijos de idioma (/ , /es, /es/, /en, /en/)
const locale = Astro.url.pathname.startsWith("/es") ? "/es" : "/en";
---
<div class="reviews-layout items-stretch">
      <div class="reviews-summary rounded-lg bg-white">
        <div class="reviews-summary__info text-paragraph">
          <p class="heading-1 fade-up-lines-raw">5.0</p>
          <img
            src="/icons/stars.svg"
            alt={locale === "/es" ? "5 estrellas" : "5 stars"}
            width="136"
            height="16"
            class="reviews-summary__stars"
            decoding="async"
            loading="lazy"
          />
          <p class="body-md fade-up-lines-raw">{content.info}</p>
        </div>
        <img
          src="/icons/logo-orange.svg"
          alt="Click Franchise"
          width="89"
          height="43"
          class="reviews-summary__logo"
          decoding="async"
          loading="lazy"
        />
      </div>

      <div
        class="reviews-carousel"
        data-reviews-carousel
        role="region"
        aria-roledescription={locale === "/es" ? "carrusel" : "carousel"}
        aria-label={locale === "/es" ? "Reseñas de clientes" : "Customer reviews"}
        tabindex="0"
      >
        <div class="reviews-carousel__viewport h-full" data-review-viewport>
          <div class="reviews-carousel__track h-full" data-review-track style={`--review-duration: ${content.items.length * 12}s;`}>
            {[0, 1].map((copy) => (
              <div class="reviews-carousel__set" aria-hidden={copy === 1 ? "true" : undefined} data-review-clone={copy === 1 ? "" : undefined}>
            {content.items.map((item, index) => (
              <article
                class="reviews-carousel__card rounded-lg bg-white h-full"
                data-review-card
                role="group"
                aria-roledescription={locale === "/es" ? "reseña" : "review"}
                aria-label={`${index + 1} ${locale === "/es" ? "de" : "of"} ${content.items.length}`}
              >
                <div class="flex flex-col justify-center items-start gap-2">
                  <p class="text-[40px] text-primary font-bold leading-[150%]" aria-hidden="true">“</p>
                  <p class="body-md text-paragraph ">{item.description}</p>
                </div>
                <div class="flex flex-col justify-center items-start text-paragraph">
                  <img
                    src="/icons/stars.svg"
                    alt={locale === "/es" ? "5 estrellas" : "5 stars"}
                    width="136"
                    height="16"
                    class="w-[69px] h-auto"
                    decoding="async"
                    loading="lazy"
                  />
                  <h3 class="mt-4 mb-2 body-md-semibold">{item.name}</h3>
                  <p class="body-sm">{item.enterprise}</p>
                </div>
              </article>
            ))}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>



<style>
  .reviews-layout {
    display: grid;
    width: 100%;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  .reviews-summary {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 2rem;
  }

  .reviews-summary__info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .reviews-summary__stars {
    width: 136px;
    height: auto;
  }

  .reviews-summary__logo {
    width: 89px;
    height: auto;
  }

  .reviews-carousel {
    width: 100%;
    min-width: 0;
  }

  .reviews-carousel__viewport {
    width: 100%;
    overflow: hidden;
    container-type: inline-size;
  }

  .reviews-carousel__track {
    display: flex;
    width: max-content;
    align-items: stretch;
    animation: reviews-scroll var(--review-duration) linear infinite;
    will-change: transform;
  }

  .reviews-carousel__set {
    display: flex;
    flex: none;
    align-items: stretch;
    gap: 1.5rem;
    padding-right: 1.5rem;
  }

  .reviews-carousel:hover .reviews-carousel__track,
  .reviews-carousel:focus-within .reviews-carousel__track {
    animation-play-state: paused;
  }

  @keyframes reviews-scroll {
    to { transform: translateX(-50%); }
  }

  .reviews-carousel__card {
    display: flex;
    min-width: 0;
    flex: 0 0 100cqi;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    padding: 2rem;
  }

  .reviews-carousel:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 4px;
  }

  @media (min-width: 640px) {
    .reviews-summary {
      flex-direction: row;
      justify-content: space-between;
      padding: 2rem;
    }

    .reviews-summary__info {
      flex-direction: row;
      gap: 1rem;
    }
  }

  @media (min-width: 768px) {
    .reviews-carousel__card {
      flex-basis: calc((100cqi - 1.5rem) / 2);
    }
  }

  @media (min-width: 1024px) {
    .reviews-layout {
      grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
      align-items: stretch;
    }

    .reviews-summary {
      flex-direction: column;
      justify-content: space-between;
      padding: clamp(2rem, 4vw, 5rem) 2rem;
    }

    .reviews-summary__info {
      flex-direction: column;
    }
  }

  @media (min-width: 1280px) {
    .reviews-carousel__card {
      flex-basis: calc((100cqi - 3rem) / 3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-carousel__viewport {
      overflow: visible;
    }

    .reviews-carousel__track {
      width: 100%;
      animation: none;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
      gap: 1.5rem;
      transform: none !important;
      transition: none;
      will-change: auto;
    }

    .reviews-carousel__set {
      display: contents;
    }

    .reviews-carousel__card {
      flex: initial;
    }

    .reviews-carousel [data-review-clone] {
      display: none;
    }
  }
</style>
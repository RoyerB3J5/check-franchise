---
import {
  emailAddress,
  facebookLink,
  instagramLink,
  phoneNumber,
  phoneNumberLink,
} from "../constants/info";
import Button from "./Button.astro";
import FormShortContact from "./FormShortContact.astro";
import Liston from "./Liston.astro";

type Translations = typeof import("../i18n/en").default;
type FooterContent = Translations["footer"];
interface Props {
  content?: FooterContent;
}
const { content } = Astro.props as Props;

// Obtener la ruta actual y normalizar el path sin prefijo de idioma
const currentPath = Astro.url.pathname;
// Normalizar: remover idioma y trailing slash
const normalized =
  currentPath.replace(/^\/(en|es)/, "").replace(/\/$/, "") || "/";
// Detectar el idioma actual ('en' o 'es')
const match = currentPath.match(/^\/(en|es)/);
const lang = match ? match[1] : "en";
const socialMedia = [
  {
    icon: "facebook",
    href: facebookLink,
  },
  {
    icon: "instagram",
    href: instagramLink,
  },
];
---

<style>
  .footer-answer {
    max-height: none;
    opacity: 1;
  }
  .footer-hover-stroke {
    -webkit-text-stroke-width: 0;
    transition: -webkit-text-stroke-width 300ms ease-in-out;
  }
  .footer-hover-stroke:hover {
    -webkit-text-stroke-width: 0.5px;
  }
</style>

<footer class="flex flex-col justify-center items-center w-full">
  <div
      class="bg-white py-16 md:py-20 flex justify-center items-center w-full relative"
    >
      <Liston src="/images/decoration-b.webp" w={630} h={354} grosor={185} class="absolute bottom-0 left-0 w-[280px] xl:w-[368px] h-auto"
      d="M -60 320 C -40 318, -27 321, 0 315 C 27 309, 58 306, 100 285 C 142 264, 200 224, 250 190 C 300 156, 358 105, 400 80 C 442 55, 476 38, 500 40 C 524 42, 545 68, 545 95 C 545 122, 519 166, 500 200 C 481 234, 448 270, 430 300 C 412 330, 403 357, 395 380 C 387 403, 385 420, 380 440" />
      <div
        class="container-full flex flex-col md:flex-row justify-center md:justify-between items-start md:items-stretch gap-[34px] md:gap-8 xl:gap-0"
      >
       <div
            class="flex flex-col justify-start items-start gap-6 max-w-none md:max-w-[280px] xl:max-w-[368px]"
          >
            <a
              href={`/${lang}`}
              aria-label="Ir a la página principal"
              title="Click Franchise - Init"
            >
              <img
                src="/icons/logo-orange.svg"
                alt="Logo de Click Franchise"
                width="90"
                height="44"
                class="cursor-pointer w-[140px] h-auto"
              />
            </a>
            <p class="text-[16px] font-medium leading-[150%] text-paragraph">
              {content?.description}
            </p>
            <div class='w-full md:hidden flex justify-center items-center gap-4'>
              <FormShortContact/>
            </div>
          </div>
          <div
            class="flex flex-col justify-center items-start gap-6 text-paragraph w-full md:w-auto border-b-[1.5px] last:border-transparent border-paragraph/30 md:border-b-0 pb-6 md:pb-0"
            data-footer-question
          >
            <div class="w-full md:flex justify-between items-center gap-4 hidden ">
              <h3 class="body-md-semibold">
                {content?.navigation.title}
              </h3>
            </div>
            <div class='w-25 h-[3px] bg-primary hidden md:block'></div>
            <div
              class="footer-answer w-full"
              id="footer-answer-navigation"
              data-footer-answer
            >
              <ul class="flex flex-col justify-center items-start gap-6">
                {
                  content?.navigation.items.map((item) => (
                    <li>
                      <a
                        href={`/${lang}${item.href}`}
                        class="footer-hover-stroke text-[16px] font-medium leading-[21px] text-paragraph flex justify-start items-center gap-2"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" width="7" height="10" viewBox="0 0 7 10" fill="none">
                          <path d="M6.24219 5.52344L1.99219 9.77344C1.67969 10.0859 1.21094 10.0859 0.929688 9.77344L0.210938 9.08594C-0.0703125 8.77344 -0.0703125 8.30469 0.210938 8.02344L3.24219 5.02344L0.210938 1.99219C-0.0703125 1.71094 -0.0703125 1.24219 0.210938 0.929688L0.929688 0.210938C1.21094 -0.0703125 1.67969 -0.0703125 1.99219 0.210938L6.24219 4.46094C6.52344 4.77344 6.52344 5.24219 6.24219 5.52344Z" fill="#F37413"/>
                        </svg>
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <div class='flex flex-col justify-between items-center'>
            <div class='flex flex-col md:flex-row justify-center items-start gap-6 xl:gap-0'>
              <div
                class="flex flex-col justify-center items-start gap-6 text-paragraph w-full md:w-auto border-b-[1.5px] last:border-transparent border-paragraph/30 md:border-b-0 pb-6 md:pb-0"
                data-footer-question
              >
                <div class="w-full flex justify-between items-center gap-4 ">
                  <h3 class="body-md-semibold">
                    {content?.contact.title}
                  </h3>
                </div>
                <div class='w-25 h-[3px] bg-primary hidden md:block'></div>
                <div
                  class="footer-answer w-full"
                  id="footer-answer-contact"
                  data-footer-answer
                >
                  <ul class="flex flex-col justify-center items-start gap-6">
                    {
                      content?.contact.items.map((item) => (
                        <li>
                          <a
                            href={item.href}
                            class="flex justify-center items-center gap-4"
                          >
                            <div class="w-6 h-6 bg-primary rounded-full md:flex justify-center items-center hidden shrink-0">
                              <img src={`/images/${item.icon}.svg`} alt={item.label} width="24" height="24" decoding="async" loading="lazy" class='w-[14.4px] h-auto'/>
                            </div>
                            <p class='footer-hover-stroke text-[16px] font-medium leading-[150%] text-paragraph'>
                              {item.label}
                            </p>
                            
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
              <div
                class="flex flex-col justify-center items-start gap-6 text-paragraph w-full md:w-auto border-b-[1.5px] last:border-transparent border-paragraph md:border-b-0"
                data-footer-question
              >
                <div class="w-full hidden md:flex justify-between items-center gap-4">
                  <h3 class="body-md-semibold">
                    {content?.socialMedias.title}
                  </h3>
                </div>
                <div class='w-25 h-[3px] bg-primary hidden md:block'></div>
                <div
                  class="footer-answer w-full"
                  id="footer-answer-services"
                  data-footer-answer
                >
                  <ul class="flex flex-row md:flex-col justify-start md:justify-center items-center md:items-start gap-6">
                    {
                      content?.socialMedias.items.map((item) => (
                        <li>
                          <a
                            href={`/${lang}${item.href}`}
                            class="footer-hover-stroke text-[16px] font-medium leading-[150%] text-paragraph flex justify-center items-center gap-2"
                          >
                            <svg xmlns="http://www.w3.org/2000/svg" width="7" height="10" viewBox="0 0 7 10" fill="none" class='hidden md:block'>
                              <path d="M6.24219 5.52344L1.99219 9.77344C1.67969 10.0859 1.21094 10.0859 0.929688 9.77344L0.210938 9.08594C-0.0703125 8.77344 -0.0703125 8.30469 0.210938 8.02344L3.24219 5.02344L0.210938 1.99219C-0.0703125 1.71094 -0.0703125 1.24219 0.210938 0.929688L0.929688 0.210938C1.21094 -0.0703125 1.67969 -0.0703125 1.99219 0.210938L6.24219 4.46094C6.52344 4.77344 6.52344 5.24219 6.24219 5.52344Z" fill="#F37413"/>
                            </svg>
                            <span class='hidden md:block'>{item.label}</span>
                            <img src={`/icons/${item.icon}.svg`} alt={item.label} class='block md:hidden w-6 h-6' decoding="async" loading="lazy" />
                          </a>  
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
            <div class='w-full hidden md:flex justify-center items-center gap-4'>
              <FormShortContact/>
            </div>
          </div>
      </div>
    </div>
  <div
    class="bg-[#E5E5E5] w-full py-3.5 lg:py-4.5 flex justify-center items-center px-5 xl:px-0"
  >
    <div
      class="w-full max-w-screen lg:max-w-7xl flex flex-col lg:flex-row justify-center items-center gap-2 lg:gap-6"
    >
      <a href="https://inkshapegroup.com/en/">
        <img
          src="/icons/inkshape.svg"
          alt=" Logo de Inkshape Group"
          width="208"
          height="40"
          class="w-27.5 lg:w-34 h-auto block dark:hidden"
        />
      </a>
      <p
        class="text-[10px] lg:text-[12px] lg:text-[13px] leading-[170%] lg:leading-[120%] text-[#404040] dark:text-paragraph-dark font-normal text-center"
      >
        Copyright © 2026 by <a href="https://inkshapegroup.com"
          >Inkshape Group</a
        > | Privacy | <a href="/">Check Franchise </a> | Atlanta, USA | Call Now:
        <a href={phoneNumberLink}>{phoneNumber}</a>
      </p>
    </div>
  </div>
</footer>

---
import {
  emailAddress,
  facebookLink,
  instagramLink,
  phoneNumber,
  phoneNumberLink,
} from "../constants/info";
import { ChevronDown, ChevronRight, Menu, X, Plus, Minus } from "@lucide/astro";

type Translations = typeof import("../i18n/en").default;
type FooterContent = Translations["footer"];
interface Props {
  content?: FooterContent;
}
const { content } = Astro.props as Props;

// Obtener la ruta actual y normalizar el path sin prefijo de idioma
const currentPath = Astro.url.pathname;
// Normalizar: remover idioma y trailing slash
const normalized =
  currentPath.replace(/^\/(en|es)/, "").replace(/\/$/, "") || "/";
// Detectar el idioma actual ('en' o 'es')
const match = currentPath.match(/^\/(en|es)/);
const lang = match ? match[1] : "en";
const socialMedia = [
  {
    icon: "facebook",
    href: facebookLink,
  },
  {
    icon: "instagram",
    href: instagramLink,
  },
];
---

<style>
  .footer-answer {
    overflow: hidden;
    transition: all 300ms ease-out;
  }
  @media (max-width: 767.98px) {
    .footer-answer:not(.is-open) {
      max-height: 0;
      opacity: 0;
    }
    .footer-answer.is-open {
      max-height: 500px;
      opacity: 1;
    }
  }
  @media (min-width: 768px) {
    .footer-answer {
      max-height: none;
      opacity: 1;
    }
  }
  .footer-toggle {
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .footer-toggle .icon-minus {
    display: none;
  }
  .footer-toggle.is-open .icon-plus {
    display: none;
  }
  .footer-toggle.is-open .icon-minus {
    display: block;
  }
  .footer-toggle:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
    border-radius: 4px;
  }
</style>

<footer class="flex flex-col justify-center items-center w-full">
  <div
    class="p-5 bg-[url('/images/footer.webp')] bg-cover bg-center bg-no-repeat w-full"
  >
    <div
      class="bg-white py-16 md:py-20 flex justify-center items-center rounded-lg"
    >
      <div
        class="container-full flex flex-col justify-center items-start gap-10"
      >
        <div
          class="w-full flex flex-col md:flex-row justify-center md:justify-between items-start gap-[34px] md:gap-8 xl:gap-0"
        >
          <div
            class="flex flex-col justify-center items-start gap-6 max-w-none md:max-w-[385px]"
          >
            <a
              href={`/${lang}`}
              aria-label="Ir a la página principal"
              title="Perla Rosati Makeup - Init"
            >
              <img
                src="/icons/logo.svg"
                alt="Logo de Perla Rosati Makeup"
                width="216"
                height="56"
                class="cursor-pointer :w-[260px] h-auto"
              />
            </a>
            <p class="text-[16px] font-normal leading-[150%] text-paragraph">
              {content?.description}
            </p>
          </div>
          <div
            class="flex flex-col justify-center items-start gap-6 text-paragraph w-full md:w-auto border-b-[1.5px] last:border-transparent border-paragraph md:border-b-0"
            data-footer-question
          >
            <div class="w-full flex justify-between items-center gap-4">
              <h3 class="text-[16px] font-medium leading-[150%] uppercase">
                {content?.navigation.title}
              </h3>
              <button
                type="button"
                class="footer-toggle flex md:hidden"
                aria-expanded="false"
                aria-controls="footer-answer-navigation"
                data-footer-toggle
              >
                <Plus class="icon-plus w-6 h-6 text-paragraph" />
                <Minus class="icon-minus w-6 h-6 text-paragraph" />
              </button>
            </div>
            <div
              class="footer-answer w-full"
              id="footer-answer-navigation"
              data-footer-answer
            >
              <ul class="flex flex-col justify-center items-start gap-6">
                {
                  content?.navigation.items.map((item) => (
                    <li>
                      <a
                        href={`/${lang}${item.href}`}
                        class="text-[16px] font-normal leading-[150%] text-paragraph hover:[-webkit-text-stroke:0.5px_currentColor] transition-all duration-300 ease-in-out"
                      >
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <div
            class="flex flex-col justify-center items-start gap-6 text-paragraph w-full md:w-auto border-b-[1.5px] last:border-transparent border-paragraph md:border-b-0"
            data-footer-question
          >
            <div class="w-full flex justify-between items-center gap-4">
              <h3 class="text-[16px] font-medium leading-[150%] uppercase">
                {content?.services.title}
              </h3>
              <button
                type="button"
                class="footer-toggle flex md:hidden"
                aria-expanded="false"
                aria-controls="footer-answer-services"
                data-footer-toggle
              >
                <Plus class="icon-plus w-6 h-6 text-paragraph" />
                <Minus class="icon-minus w-6 h-6 text-paragraph" />
              </button>
            </div>
            <div
              class="footer-answer w-full"
              id="footer-answer-services"
              data-footer-answer
            >
              <ul class="flex flex-col justify-center items-start gap-6">
                {
                  content?.services.items.map((item) => (
                    <li>
                      <a
                        href={`/${lang}${item.href}`}
                        class="text-[16px] font-normal leading-[150%] text-paragraph hover:[-webkit-text-stroke:0.5px_currentColor] transition-all duration-300 ease-in-out"
                      >
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
          <div
            class="flex flex-col justify-center items-start gap-6 text-paragraph w-full md:w-auto border-b-[1.5px] last:border-transparent border-paragraph md:border-b-0"
            data-footer-question
          >
            <div class="w-full flex justify-between items-center gap-4">
              <h3 class="text-[16px] font-medium leading-[150%] uppercase">
                {content?.contact.title}
              </h3>
              <button
                type="button"
                class="footer-toggle flex md:hidden"
                aria-expanded="false"
                aria-controls="footer-answer-contact"
                data-footer-toggle
              >
                <Plus class="icon-plus w-6 h-6 text-paragraph" />
                <Minus class="icon-minus w-6 h-6 text-paragraph" />
              </button>
            </div>
            <div
              class="footer-answer w-full"
              id="footer-answer-contact"
              data-footer-answer
            >
              <ul class="flex flex-col justify-center items-start gap-6">
                {
                  content?.contact.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="text-[16px] font-normal leading-[150%] text-paragraph hover:[-webkit-text-stroke:0.5px_currentColor] transition-all duration-300 ease-in-out "
                      >
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
        <div class="flex justify-start items-center gap-2 w-full">
          {
            socialMedia.map((item) => (
              <a
                href={item.href}
                class="w-10 h-10 border border-paragraph rounded-full flex justify-center items-center hover:bg-secondary hover:border-secondary transition-all duration-300 ease-in-out"
              >
                <img
                  src={`/icons/${item.icon}.svg`}
                  width="24"
                  height="24"
                  class="w-auto h-4.5"
                  decoding="async"
                  loading="lazy"
                  alt={item.icon}
                />
              </a>
            ))
          }
        </div>
        <p class="text-[12px] font-normal leading-[150%] text-paragraph">
          {content?.copy}
        </p>
      </div>
    </div>
  </div>
  <div
    class="bg-[#E5E5E5] w-full py-3.5 lg:py-4.5 flex justify-center items-center px-5 xl:px-0"
  >
    <div
      class="w-full max-w-screen lg:max-w-7xl flex flex-col lg:flex-row justify-center items-center gap-2 lg:gap-6"
    >
      <a href="https://inkshapegroup.com/en/">
        <img
          src="/icons/inkshape.svg"
          alt=" Logo de Inkshape Group"
          width="208"
          height="40"
          class="w-27.5 lg:w-34 h-auto block dark:hidden"
        />
      </a>
      <p
        class="text-[10px] lg:text-[12px] lg:text-[13px] leading-[170%] lg:leading-[120%] text-[#404040] dark:text-paragraph-dark font-normal text-center"
      >
        Copyright © 2026 by <a href="https://inkshapegroup.com"
          >Inkshape Group</a
        > | Privacy | <a href="/">Perla Rpsati Makeup </a> | Florida, USA | Call Now:
        <a href={phoneNumberLink}>{phoneNumber}</a>
      </p>
    </div>
  </div>
</footer>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const items = document.querySelectorAll("[data-footer-question]");
    if (!items.length) return;

    const isDesktop = () => window.innerWidth >= 768;

    const setOpen = (item, open) => {
      const answer = item.querySelector("[data-footer-answer]");
      const btn = item.querySelector("[data-footer-toggle]");
      if (!answer || !btn) return;
      answer.classList.toggle("is-open", open);
      btn.classList.toggle("is-open", open);
      btn.setAttribute("aria-expanded", String(open));
    };

    items.forEach((item) => {
      const btn = item.querySelector("[data-footer-toggle]");
      const answer = item.querySelector("[data-footer-answer]");
      if (!btn || !answer) return;

      btn.addEventListener("click", () => {
        if (isDesktop()) return;
        const currentlyOpen = answer.classList.contains("is-open");
        if (currentlyOpen) {
          setOpen(item, false);
        } else {
          items.forEach((other) => {
            if (other !== item) setOpen(other, false);
          });
          setOpen(item, true);
        }
      });
    });

    window.addEventListener("resize", () => {
      if (isDesktop()) {
        items.forEach((item) => setOpen(item, false));
      }
    });
  });
</script>

---
// src/components/Liston.astro
interface Props {
  src: string;        // ruta de la imagen, ej. "/images/decoration-l.webp"
  d: string;          // curva central del listón (la máscara)
  w: number;          // ancho de la imagen
  h: number;          // alto de la imagen
  grosor?: number;
  duracion?: number;  // segundos
  delay?: number;     // segundos
  class?: string;
}
const {
  src, d, w, h,
  grosor = 95, duracion = 1.5, delay = 0,
  class: className,
  ...rest
} = Astro.props;
const id = `m-${crypto.randomUUID().slice(0, 8)}`; // id único por instancia
---
<svg
  class:list={["liston", "reveal-liston", "hidden", "md:block", className]}
  viewBox={`0 0 ${w} ${h}`}
  style={`--dur:${duracion}s;--delay:${delay}s`}
  aria-hidden="true"
  {...rest}
>
  <defs>
    <mask id={id} maskUnits="userSpaceOnUse" x={-50} y={0} width={w + 100} height={h}>
      <path class="trazo" pathLength="1" d={d} fill="none"
            stroke="white" stroke-width={grosor} stroke-linecap="butt" />
    </mask>
  </defs>
  <image href={src} width={w} height={h} mask={`url(#${id})`} />
</svg>

<script>
  import { gsap, ScrollTrigger } from "../lib/gsap";
  import { CustomEase } from "gsap/CustomEase";

  gsap.registerPlugin(CustomEase);
  const listonEase = CustomEase.create("liston-reveal", "0.65, 0, 0.35, 1");

  let listonMedia: any;
  let initializedListons: SVGSVGElement[] = [];
  let refreshFrame = 0;
  let initializationFrame = 0;

  // Deja que las demás secciones registren sus ScrollTriggers (incluidos los
  // que fijan secciones) antes de medir las posiciones de cada listón.
  const scheduleListonRefresh = () => {
    if (refreshFrame) cancelAnimationFrame(refreshFrame);

    refreshFrame = requestAnimationFrame(() => {
      refreshFrame = requestAnimationFrame(() => {
        refreshFrame = 0;
        ScrollTrigger.refresh();
      });
    });
  };

  const initializeListons = () => {
    const listons = [
      ...document.querySelectorAll<SVGSVGElement>(".reveal-liston"),
    ];
    if (listons.length === 0) return;
    if (
      listons.length === initializedListons.length &&
      listons.every((liston, index) => liston === initializedListons[index])
    ) {
      return;
    }

    listonMedia?.revert();
    initializedListons = listons;
    listonMedia = gsap.matchMedia();

    const paths = listons
      .map((liston) => liston.querySelector<SVGPathElement>(".trazo"))
      .filter((path): path is SVGPathElement => path !== null);

    listonMedia.add("(prefers-reduced-motion: no-preference)", () => {
      listons.forEach((liston) => {
        const path = liston.querySelector<SVGPathElement>(".trazo");
        if (!path) return;

        const styles = getComputedStyle(liston);
        const duration = Number.parseFloat(styles.getPropertyValue("--dur"));
        const delay = Number.parseFloat(styles.getPropertyValue("--delay"));
        const pinnedContainer = ScrollTrigger.getAll().find(
          (trigger) => trigger.pin?.contains(liston),
        )?.pin;

        gsap.fromTo(
          path,
          { strokeDashoffset: 1 },
          {
            strokeDashoffset: 0,
            // El path está normalizado a 1: redondearlo a píxeles hace que salte a 0.
            autoRound: false,
            duration: Number.isFinite(duration) ? duration : 1.5,
            delay: Number.isFinite(delay) ? delay : 0,
            ease: listonEase,
            scrollTrigger: {
              trigger: liston,
              // Mide los listones después de los pins de otras secciones.
              // GSAP activa la ordenación en cada refresh al definir esta prioridad.
              refreshPriority: -1,
              pinnedContainer,
              // Mantiene los límites alcanzables al inicio y al final de la página.
              start: "clamp(top 80%)",
              // Al subir, empieza la reversa con el borde inferior a mitad
              // de pantalla, mientras el listón todavía tiene una parte visible.
              end: "clamp(bottom 50%)",
              toggleActions: "play play reverse reverse",
              // También responde si se cambia de dirección sin salir de la zona.
              onUpdate: (self) => {
                if (!self.isActive) return;
                if (self.direction > 0) self.animation?.play();
                else self.animation?.reverse();
              },
              invalidateOnRefresh: true,
            },
          },
        );
      });

      scheduleListonRefresh();
    });

    listonMedia.add("(prefers-reduced-motion: reduce)", () => {
      gsap.set(paths, { strokeDashoffset: 0 });
    });
  };

  const teardownListons = () => {
    cancelAnimationFrame(initializationFrame);
    if (refreshFrame) cancelAnimationFrame(refreshFrame);
    refreshFrame = 0;
    listonMedia?.revert();
    listonMedia = undefined;
    initializedListons = [];
  };

  document.addEventListener("astro:before-swap", teardownListons);
  const scheduleListonInitialization = () => {
    cancelAnimationFrame(initializationFrame);
    initializationFrame = requestAnimationFrame(initializeListons);
  };
  document.addEventListener("astro:page-load", scheduleListonInitialization);
  window.addEventListener("load", scheduleListonRefresh, { once: true });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", scheduleListonInitialization, { once: true });
  } else {
    scheduleListonInitialization();
  }
</script>

<style>
  .trazo {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .trazo { stroke-dashoffset: 0; }
  }
</style>

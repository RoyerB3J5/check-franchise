---
const icons = [
  {
    name: "ig",
    href: "#",
  },
  {
    name: "linkedin",
    href: "#",
  },
  {
    name: "fb",
    href: "#",
  },
  {
    name: "youtube",
    href: "#",
  },
];
---

<div class="flex justify-center items-center gap-4 w-full">
  {
    icons.map((i) => (
      <a
        href={i.href}
        class="p-2 rounded-full flex items-center justify-center shrink-0"
      >
        <img src={`/icons/${i.name}.svg`} alt={i.name} class="w-6 h-6" />
      </a>
    ))
  }
</div>

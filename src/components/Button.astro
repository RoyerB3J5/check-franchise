---
interface Props {
  /** Texto del botón. Si no se pasa, se renderiza el slot */
  text?: string;
  /** Si se pasa, el componente renderiza un enlace `<a>` en lugar de `<button>` */
  href?: string;
  /** target para el enlace (ej. `_blank`) */
  target?: string;
  /** rel para el enlace; por defecto se aplica `noopener noreferrer` cuando target === '_blank' */
  rel?: string;
  /** Clase base para el botón (layout, paddings, rounded, etc) */
  baseBtnClass?: string;
  /** Clases adicionales que el usuario quiera aplicar (border, bg color, etc) */
  extraBtnClass?: string;
  /** Clase base para el texto */
  baseTextClass?: string;

  textClass?: string;
  changeColor?: boolean;
  /** Nombre del icono (se busca en /images/{icon}.svg) */
  icon?: string;
}

const {
  text = "",
  baseBtnClass = "flex justify-center items-center gap-2 cursor-pointer transition-all duration-300 ease-in-out z-[10] box-border py-4 px-8 w-full md:w-auto rounded-[8px]",
  extraBtnClass = "",
  baseTextClass = "text-[16px] font-semibold  leading-[150%]",
  textClass = "",
  href,
  target,
  rel,
  changeColor,
  icon,
} = Astro.props as Props;

const extraClasses = extraBtnClass.split(/\s+/).filter(Boolean);
const surfaceClasses = extraClasses.filter(
  (className) => className.startsWith("bg-") || className.startsWith("shadow-"),
);
const layoutClasses = extraClasses.filter((className) => !surfaceClasses.includes(className));
const shadowColor = surfaceClasses
  .find((className) => className.startsWith("shadow-"))
  ?.match(/^shadow-\[0_8px_0_0_(#[\da-fA-F]{3,8})\]$/)?.[1];

// Normalizar hrefs comunes: si por error tiene una barra inicial antes
// de un esquema `tel:` o `mailto:` la removemos para evitar rutas internas
const normalizedHref =
  typeof href === "string" && /^\/(tel:|mailto:)/.test(href)
    ? href.replace(/^\/+/, "")
    : href;

// No id necesario: usamos atributos data- para el script cliente

// Construir clases finales
const buttonClasses =
  `${baseBtnClass} ${layoutClasses.join(" ")} button-control relative isolate ${
    shadowColor ? "button-has-compressible-shadow" : ""
  }`.trim();
const paragraphClasses = `${baseTextClass} ${textClass}`.trim();
---

{
  href ? (
    <a
      href={normalizedHref}
      class={buttonClasses}
      target={target}
      rel={rel ?? (target === "_blank" ? "noopener noreferrer" : undefined)}
    >
      <span
        aria-hidden="true"
        class:list={["button-surface", ...surfaceClasses]}
        style={shadowColor ? `--button-shadow-color: ${shadowColor};` : undefined}
      ></span>
      {
        icon ? 
          <img src={`/images/${icon}.svg`} alt={icon} class="w-[16px] h-[16px]" /> : null 
      }
      {text ? <p class={paragraphClasses}>{text}</p> : <slot />}
      
    </a>
  ) : (
    <button type="button" class={buttonClasses}>
      <span
        aria-hidden="true"
        class:list={["button-surface", ...surfaceClasses]}
        style={shadowColor ? `--button-shadow-color: ${shadowColor};` : undefined}
      ></span>
      {
        icon ? 
          <img src={`/images/${icon}.svg`} alt={icon} class="w-[16px] h-[16px]" /> : null 
      }
      {text ? <p class={paragraphClasses}>{text}</p> : <slot />}
    </button>
  )
}

<script>
  const clickAnimations = new WeakMap<HTMLElement, Animation>();

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLElement>(".button-control");
    const surface = button?.querySelector<HTMLElement>(".button-surface");
    if (!button || !surface || matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    clickAnimations.get(surface)?.cancel();
    const styles = getComputedStyle(surface);
    const rest = { transform: styles.transform, boxShadow: styles.boxShadow };
    const shadowColor = styles.getPropertyValue("--button-shadow-color").trim();
    const animation = surface.animate(
      [
        rest,
        {
          transform: "scale(0.97)",
          boxShadow: shadowColor ? `0 3px 0 0 ${shadowColor}` : rest.boxShadow,
          offset: 0.4,
        },
        rest,
      ],
      { duration: 350, easing: "ease-in-out" },
    );
    clickAnimations.set(surface, animation);
  });
</script>

<style>
  .button-control {
    position: relative;
    isolation: isolate;
  }

  .button-surface {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    pointer-events: none;
    transition:
      transform 300ms ease-in-out,
      box-shadow 300ms ease-in-out;
  }

  .button-control:hover .button-surface {
    transform: scale(1.03);
  }

</style>

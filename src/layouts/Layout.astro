---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Chatbot from "../components/Chatbot.astro";
import SEOHead from "../components/SEOHead.astro";

type Translations = typeof import("../i18n/en").default;

export interface Props {
  lang: string;
  t?: Translations;
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonicalPath?: string;
  noindex?: boolean;
  type?: string;
  structuredData?: object | object[];
}

const {
  lang,
  t,
  title,
  description,
  keywords,
  image,
  canonicalPath,
  noindex,
  type,
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang={lang} class="overflow-x-clip">
  <head>
    <SEOHead
      lang={lang}
      title={title}
      description={description}
      keywords={keywords}
      image={image}
      canonicalPath={canonicalPath}
      noindex={noindex}
      type={type}
      structuredData={structuredData}
    />
  </head>

  <body
    class="font-family antialiased overflow-x-clip bg-white flex flex-col justify-center items-center w-full"
  >
    <Header content={t?.header} />
    <main class="flex flex-col w-full items-center justify-center pt-(--header-height)">
      <slot />
    </main>
    <Footer content={t?.footer} />
		{
			/*
    <Chatbot /> */
		}
    
  </body>
</html>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const prepareLineReveal = (element) => {
      // Desenvuelve cualquier split anterior para volver a medir el texto limpio.
      element
        .querySelectorAll(".fade-up-line-word, .fade-up-line-fragment")
        .forEach((wrapper) => wrapper.replaceWith(...wrapper.childNodes));

      const textNodes = [];
      const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT);
      let node;

      while ((node = walker.nextNode())) {
        if (/\S/.test(node.textContent ?? "")) textNodes.push(node);
      }

      textNodes.forEach((textNode) => {
        const tokens = textNode.textContent.match(/\s+|\S+/gu) ?? [];
        const fragment = document.createDocumentFragment();

        tokens.forEach((token) => {
          if (/^\s+$/u.test(token)) {
            fragment.append(document.createTextNode(token));
            return;
          }

          const word = document.createElement("span");
          word.className = "fade-up-line-word";
          const wordFragment = document.createElement("span");
          wordFragment.className = "fade-up-line-fragment";
          wordFragment.textContent = token;
          word.append(wordFragment);
          fragment.append(word);
        });

        textNode.replaceWith(fragment);
      });

      const words = [...element.querySelectorAll(".fade-up-line-word")];
      const lineHeight = parseFloat(getComputedStyle(element).lineHeight);
      const lineTolerance = Number.isFinite(lineHeight) ? lineHeight * 0.35 : 4;
      let lineIndex = -1;
      let previousTop = null;

      words.forEach((word) => {
        const top = word.getBoundingClientRect().top;
        if (previousTop === null || Math.abs(top - previousTop) > lineTolerance) {
          lineIndex += 1;
          previousTop = top;
        }
        word.firstElementChild.style.setProperty(
          "--fade-up-line-delay",
          `${lineIndex * 0.1}s`,
        );
      });
    };

    const revealElement = (element) => {
      // Fuerza un reflow para que el navegador vea el estado inicial antes de animar.
      element.getBoundingClientRect();
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          element.classList.add("active");
        });
      });
    };

    const animationObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const el = entry.target;

          if (entry.isIntersecting) {
            revealElement(el);
            animationObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.3 },
    );

    const lineRevealElements = [
      ...document.querySelectorAll(".fade-up-lines, .fade-up-lines-raw"),
    ];
    const otherAnimationElements = document.querySelectorAll(
      ".fade-up-a, .fade-down-a, .fade-left-a, .fade-right-a, .fade-up-words, .fade-up-slow, .reveal-ltr, .reveal-rtl, .reveal-tl-br, .fade-up-gallery, .zoom-out-a",
    );

    otherAnimationElements.forEach((element) => {
      if (
        !element.classList.contains("fade-up-lines") &&
        !element.classList.contains("fade-up-lines-raw")
      ) {
        animationObserver.observe(element);
      }
    });

    const initializeLineReveals = () => {
      lineRevealElements.forEach((element) => {
        prepareLineReveal(element);
        animationObserver.observe(element);
      });
    };

    if (document.fonts?.ready) {
      document.fonts.ready.then(initializeLineReveals);
    } else {
      initializeLineReveals();
    }

    let lineResizeTimeout;
    window.addEventListener("resize", () => {
      window.clearTimeout(lineResizeTimeout);
      lineResizeTimeout = window.setTimeout(() => {
        lineRevealElements.forEach(prepareLineReveal);
      }, 120);
    });
  });
</script>

<script define:vars={{ devMode: import.meta.env.DEV }}>
  if (devMode) {
    const storageKey = "click-franchise-dev-scroll";
    const currentLocation =
      window.location.pathname + window.location.search + window.location.hash;
    const navigation = performance.getEntriesByType("navigation")[0];
    let savedPosition = null;

    try {
      savedPosition = JSON.parse(sessionStorage.getItem(storageKey) ?? "null");
    } catch {
      sessionStorage.removeItem(storageKey);
    }

    sessionStorage.removeItem(storageKey);

    window.addEventListener("pagehide", () => {
      sessionStorage.setItem(
        storageKey,
        JSON.stringify({
          location: currentLocation,
          x: window.scrollX,
          y: window.scrollY,
        }),
      );
    });

    if (
      navigation?.type === "reload" &&
      savedPosition?.location === currentLocation &&
      Number.isFinite(savedPosition.x) &&
      Number.isFinite(savedPosition.y)
    ) {
      const restorePosition = () => {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            window.scrollTo(savedPosition.x, savedPosition.y);
          });
        });
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", restorePosition, {
          once: true,
        });
      } else {
        restorePosition();
      }
    }
  }
</script>

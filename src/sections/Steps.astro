---
import Liston from "../components/Liston.astro";

type Translations = typeof import("../i18n/en").default;
type Content = Translations["buyFranchise"]["steps"];
interface Props {
  content: Content;
}
const { content} = Astro.props as Props;
---
<section class='bg-white w-full flex justify-center items-center relative' data-steps-section>
  <Liston src="/images/decoration-o-l.webp" w={230} h={776} grosor={185}
  d="M -60 -80 C -27 3, 5 93, 40 170 C 75 247, 126 315, 150 380 C 174 445, 188 512, 185 560 C 182 608, 151 648, 130 670 C 109 692, 92 684, 60 692 C 28 700, -20 707, -60 715" class="absolute bottom-[-15%] left-0 w-[105px] h-auto object-cover  z-11" />
  <Liston src="/images/decoration-o-r.webp" w={284} h={656} grosor={230} d="M 330 700 C 303 640, 280 573, 250 520 C 220 467, 178 425, 150 380 C 122 335, 93 288, 80 250 C 67 212, 63 176, 70 150 C 77 124, 98 103, 120 95 C 142 87, 173 91, 200 100 C 227 109, 257 135, 284 150 C 311 165, 335 177, 360 190" class="absolute top-[-10%] right-0 w-[133px] h-auto object-cover z-11" />
  <div class='container-full flex flex-col justify-center items-center py-14 md:py-20 xl:py-25 gap-10 relative z-10'>
    <div class='flex flex-col justify-center items-start md:items-center gap-8 text-paragraph w-full md:w-auto'>
      <p class='body-sm uppercase fade-up-lines'>
        {content.tag}
      </p>
      <h2 class="heading-1 text-start md:text-center fade-up-lines" set:html={content.title}></h2>
    </div>
    <div class='w-full grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 justify-center items-start'>
      {
        content.items.map((item, index)=>( 
          <button
            type="button"
            class={`breakpoint-card bg-primary w-full flex flex-col justify-between items-start p-8 bg-[#F3F0E9] border-0 rounded-lg text-left h-auto aspect-443/330 md:aspect-443/380 xl:aspect-443/330`}
            aria-expanded="false"
            data-breakpoint-card
            data-step-index={index}
          >
            <p class='heading-1 self-end'>0{index + 1}</p>
            <div class="flex flex-col justify-center items-start text-paragraph">
              <h3 class='heading-3'>
                {item.title}
              </h3>
              <div class="breakpoint-card__details">
                <div class="w-10 h-0.75 bg-paragraph my-8"></div>
                <p class='body-md'>
                  {item.description}
                </p>
              </div>
            </div>
          </button>  
        ))
      }
      <div class='w-full h-auto aspect-443/330 overflow-hidden rounded-lg relative hidden md:block' aria-live="polite">
        {
          content.items.map((item, index) => (
            <img
              src={`/images/step-${index + 1}.webp`}
              alt={item.title}
              class="step-preview w-full h-full object-cover absolute inset-0"
              width="443"
              height="330"
              decoding="async"
              loading="lazy"
              aria-hidden="true"
              data-step-preview={index}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll<HTMLButtonElement>(
    "[data-steps-section] [data-breakpoint-card]",
  );
  const previews = document.querySelectorAll<HTMLImageElement>(
    "[data-steps-section] [data-step-preview]",
  );
  const usesTapInteraction = window.matchMedia("(max-width: 1023px)");
  let activePreviewIndex: string | undefined;

  const showPreview = (card: HTMLButtonElement) => {
    activePreviewIndex = card.dataset.stepIndex;
    previews.forEach((preview) => {
      const isActive = preview.dataset.stepPreview === activePreviewIndex;
      preview.classList.toggle("is-visible", isActive);
      preview.setAttribute("aria-hidden", String(!isActive));
    });
  };

  const hidePreview = (card: HTMLButtonElement) => {
    if (activePreviewIndex !== card.dataset.stepIndex) return;

    activePreviewIndex = undefined;
    previews.forEach((preview) => {
      preview.classList.remove("is-visible");
      preview.setAttribute("aria-hidden", "true");
    });
  };

  cards.forEach((card) => {
    card.addEventListener("mouseenter", () => {
      if (!usesTapInteraction.matches) showPreview(card);
    });

    card.addEventListener("mouseleave", () => {
      if (!usesTapInteraction.matches) hidePreview(card);
    });

    card.addEventListener("click", () => {
      const isExpanded = card.getAttribute("aria-expanded") === "true";
      card.setAttribute("aria-expanded", String(!isExpanded));
      card.classList.toggle("is-active", !isExpanded);

      if (usesTapInteraction.matches) {
        if (isExpanded) hidePreview(card);
        else showPreview(card);
      }
    });
  });
</script>

<style>
  .step-preview {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 450ms ease-in-out,
      visibility 0s linear 450ms;
  }

  .step-preview.is-visible {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  .breakpoint-card {
    background-color: #f3f0e9;
    transition:
      background-color 400ms ease-in-out,
      color 300ms ease-in-out;
  }

  .breakpoint-card__details {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding-bottom: 0.25rem;
    transform: translateY(0.75rem);
    transition:
      max-height 400ms ease-in-out,
      opacity 300ms ease-in-out,
      transform 400ms ease-in-out;
  }

  .breakpoint-card__icon--back {
    transform: scale(0.8);
  }

  @media (min-width: 1024px) {
    .breakpoint-card.bg-primary:hover,
    .breakpoint-card.bg-primary.is-active {
      background-color: var(--color-primary);
    }

    .breakpoint-card.bg-secondary:hover,
    .breakpoint-card.bg-secondary.is-active {
      background-color: var(--color-secondary);
    }

    .breakpoint-card.bg-third:hover,
    .breakpoint-card.bg-third.is-active {
      background-color: var(--color-third);
    }

    .breakpoint-card:hover,
    .breakpoint-card.is-active {
      color: var(--color-paragraph);
    }

    .breakpoint-card:hover .breakpoint-card__details,
    .breakpoint-card.is-active .breakpoint-card__details {
      max-height: 12rem;
      opacity: 1;
      transform: translateY(0);
    }

    .breakpoint-card:hover .breakpoint-card__icon:not(.breakpoint-card__icon--back),
    .breakpoint-card.is-active .breakpoint-card__icon:not(.breakpoint-card__icon--back) {
      opacity: 0;
      transform: scale(0.8);
    }

    .breakpoint-card:hover .breakpoint-card__icon--back,
    .breakpoint-card.is-active .breakpoint-card__icon--back {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 1023px) {
    .breakpoint-card.bg-primary.is-active {
      background-color: var(--color-primary);
    }

    .breakpoint-card.bg-secondary.is-active {
      background-color: var(--color-secondary);
    }

    .breakpoint-card.bg-third.is-active {
      background-color: var(--color-third);
    }

    .breakpoint-card.is-active {
      color: var(--color-paragraph);
    }

    .breakpoint-card.is-active .breakpoint-card__details {
      max-height: 12rem;
      opacity: 1;
      transform: translateY(0);
    }

    .breakpoint-card.is-active .breakpoint-card__icon:not(.breakpoint-card__icon--back) {
      opacity: 0;
      transform: scale(0.8);
    }

    .breakpoint-card.is-active .breakpoint-card__icon--back {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .breakpoint-card,
    .breakpoint-card__details,
    .breakpoint-card__icon,
    .step-preview {
      transition-duration: 0.01ms;
    }

    .step-preview {
      transition-delay: 0ms;
    }
  }
</style>

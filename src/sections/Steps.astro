---
type Translations = typeof import("../i18n/en").default;
type Content = Translations["buyFranchise"]["steps"];
interface Props {
  content: Content;
}
const { content} = Astro.props as Props;
---
<section class='bg-white w-full flex justify-center items-center relative'>
  <img src="/images/decoration-o-l.webp" alt="Decoration" class="absolute bottom-[-10%] left-0 w-[145px] h-auto object-cover z-5" width="145" height="400" decoding="async" loading="lazy"/>
  <img src="/images/decoration-o-r.webp" alt="Decoration" class="absolute top-[-10%] right-0 w-[153px] h-auto object-cover" width="153" height="346" decoding="async" loading="lazy"/>
  <div class='container-full flex flex-col justify-center items-center py-25 gap-10'>
    <div class='flex flex-col justify-center items-center gap-8 text-paragraph'>
      <p class='body-sm uppercase'>
        {content.tag}
      </p>
      <h2 class="heading-1 text-center" set:html={content.title}></h2>
    </div>
    <div class='w-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 justify-center items-start'>
      {
        content.items.map((item, index)=>( 
          <button
            type="button"
            class={`breakpoint-card bg-primary w-full flex flex-col justify-between items-start p-8 bg-[#F3F0E9] border-0 rounded-lg text-left h-auto aspect-443/330`}
            aria-expanded="false"
            data-breakpoint-card
          >
            <p class='heading-1 self-end'>0{index + 1}</p>
            <div class="flex flex-col justify-center items-start text-paragraph">
              <h3 class='heading-3'>
                {item.title}
              </h3>
              <div class="breakpoint-card__details">
                <div class="w-10 h-0.75 bg-paragraph my-8"></div>
                <p class='body-md'>
                  {item.description}
                </p>
              </div>
            </div>
          </button>  
        ))
      }
      <div class='w-full h-auto aspect-443/330 overflow-hidden rounded-lg relative' >
        <img src="/images/steps.webp" alt="Steps" class="w-full h-full object-cover absolute inset-0" width="443" height="330" decoding="async" loading="lazy"/>
      </div>
    </div>
  </div>
</section>

<script>
  const cards = document.querySelectorAll<HTMLButtonElement>("[data-breakpoint-card]");

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const isExpanded = card.getAttribute("aria-expanded") === "true";
      card.setAttribute("aria-expanded", String(!isExpanded));
      card.classList.toggle("is-active", !isExpanded);
    });
  });
</script>

<style>
  .breakpoint-card {
    background-color: #f3f0e9;
    transition:
      background-color 400ms ease-in-out,
      color 300ms ease-in-out;
  }

  .breakpoint-card__details {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding-bottom: 0.25rem;
    transform: translateY(0.75rem);
    transition:
      max-height 400ms ease-in-out,
      opacity 300ms ease-in-out,
      transform 400ms ease-in-out;
  }

  .breakpoint-card__icon--back {
    transform: scale(0.8);
  }

  @media (min-width: 768px) {
    .breakpoint-card.bg-primary:hover,
    .breakpoint-card.bg-primary.is-active {
      background-color: var(--color-primary);
    }

    .breakpoint-card.bg-secondary:hover,
    .breakpoint-card.bg-secondary.is-active {
      background-color: var(--color-secondary);
    }

    .breakpoint-card.bg-third:hover,
    .breakpoint-card.bg-third.is-active {
      background-color: var(--color-third);
    }

    .breakpoint-card:hover,
    .breakpoint-card.is-active {
      color: var(--color-paragraph);
    }

    .breakpoint-card:hover .breakpoint-card__details,
    .breakpoint-card.is-active .breakpoint-card__details {
      max-height: 12rem;
      opacity: 1;
      transform: translateY(0);
    }

    .breakpoint-card:hover .breakpoint-card__icon:not(.breakpoint-card__icon--back),
    .breakpoint-card.is-active .breakpoint-card__icon:not(.breakpoint-card__icon--back) {
      opacity: 0;
      transform: scale(0.8);
    }

    .breakpoint-card:hover .breakpoint-card__icon--back,
    .breakpoint-card.is-active .breakpoint-card__icon--back {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (max-width: 767px) {
    .breakpoint-card.bg-primary.is-active {
      background-color: var(--color-primary);
    }

    .breakpoint-card.bg-secondary.is-active {
      background-color: var(--color-secondary);
    }

    .breakpoint-card.bg-third.is-active {
      background-color: var(--color-third);
    }

    .breakpoint-card.is-active {
      color: var(--color-paragraph);
    }

    .breakpoint-card.is-active .breakpoint-card__details {
      max-height: 12rem;
      opacity: 1;
      transform: translateY(0);
    }

    .breakpoint-card.is-active .breakpoint-card__icon:not(.breakpoint-card__icon--back) {
      opacity: 0;
      transform: scale(0.8);
    }

    .breakpoint-card.is-active .breakpoint-card__icon--back {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .breakpoint-card,
    .breakpoint-card__details,
    .breakpoint-card__icon {
      transition-duration: 0.01ms;
    }
  }
</style>
---
import Button from "../../components/Button.astro";

type Translations = typeof import("../../i18n/en").default;
type Content = Translations["main"]["banner"];
interface Props {
  content: Content;
}
const { content} = Astro.props as Props;
---
<section class="w-full h-[100svh] flex justify-center items-center relative">
  
  <img src="/images/banner.webp" alt="Banner" class="w-full h-full object-cover absolute inset-0 object-left" width="1672" height="941" decoding="async" loading="lazy"/>
  <div class="container-full flex flex-col justify-start items-start gap-8 h-full py-20 3xl:py-30 relative z-5">
    <h1 class='heading-1 max-w-[559px] text-start' set:html={content.title}></h1>
    <p class='body-md max-w-[559px] text-start'>{content.description}</p>
    <div class='flex justify-center itmes-center gap-4'>
      <Button text={content.buttons[0].label} href={content.buttons[0].href} extraBtnClass="bg-[#F37413] shadow-[0_8px_0_0_#A64B06]" textClass="text-white" />
      <Button text={content.buttons[1].label} href={content.buttons[1].href} icon="whats" extraBtnClass="bg-[#25D366] shadow-[0_8px_0_0_#137839]" textClass="text-white"/>
    </div>
  </div>  
</section>
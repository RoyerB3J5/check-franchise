---
import Liston from "../../components/Liston.astro";

type Translations = typeof import("../../i18n/en").default;
type Content = Translations["main"]["cifras"];
interface Props {
  content: Content;
}
const { content} = Astro.props as Props;
---
<section class='w-full h-screen relative flex justify-center items-center p-8 bg-white z-5'>
  <div class='bg-secondary flex justify-center items-center w-full h-full'>
    <div class="container-full flex flex-col justify-between items-start py-[156px] text-paragraph h-full">
      <h2 class="heading-1">
        {content.title}
      </h2>
      <p class="text-[320px] font-medium leading-[110%] uppercase tracking-[6.4px] self-center text-center">
        {content.item[0].number}
      </p>
      <p class="heading-3 self-end">
        {content.item[0].tag}
      </p>
    </div>
  </div>
  <Liston
    src="/images/decoration-l.webp"
    w={115} h={411}
    d="M -20 88 C 45 88, 125 180, 100 245 C 80 300, 45 348, -20 348"
    grosor={120}
    class="absolute bottom-[-10%] left-0 w-[115px] h-auto"
  />
</section>  
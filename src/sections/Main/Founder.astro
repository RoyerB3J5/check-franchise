---
import Liston from "../../components/Liston.astro";
import FounderContent from "../FounderContent.astro";

type Translations = typeof import("../../i18n/en").default;
type Content = Translations["main"]["founder"];
interface Props {
  content: Content;
}
const { content} = Astro.props as Props;
---
<section class="w-full flex justify-center items-center bg-white relative py-25" data-banner-transition-panel>
  <Liston src="/images/decoration-o-l.webp" w={230} h={776} grosor={185}
  d="M -60 -80 C -27 3, 5 93, 40 170 C 75 247, 126 315, 150 380 C 174 445, 188 512, 185 560 C 182 608, 151 648, 130 670 C 109 692, 92 684, 60 692 C 28 700, -20 707, -60 715" class="absolute bottom-[-10%] left-0 w-[145px] h-auto object-cover z-5" />
  <div class="w-full" data-banner-transition-inner>
    <FounderContent content={content} />
  </div>
</section>

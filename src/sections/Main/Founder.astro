---
type Translations = typeof import("../../i18n/en").default;
type Content = Translations["main"]["founder"];
interface Props {
  content: Content;
}
const { content} = Astro.props as Props;
---
<section class="w-full flex justify-center items-center bg-white relative">
  <img src="/images/decoration-o-l.webp" alt="Decoration" class="absolute bottom-[-10%] left-0 w-[145px] h-auto object-cover z-5" width="145" height="400" decoding="async" loading="lazy"/>
  <div class='container-full flex justify-center items-stretch py-25 gap-6 relative'>
    <div class="w-[34%] flex flex-col justify-start items-start text-white p-8 rounded-lg bg-accent gap-20">
      <img src="/icons/person.svg" alt="Icono de Persona" width="30" height="24" decoding="async" loading="lazy" class='w-[30px] h-auto self-end'/>
      <div class="flex flex-col justify-center items-start gap-6">
        <p class="uppercase body-sm">{content.tag}</p>
        <h2 class="heading-3 text-secondary">Esdras Ribeiro</h2>
        <p class='body-md tracking-[0.64px]'>{content.subtitle}</p>
        <div class="w-10 h-[3px] bg-white"></div>
      </div>
      <p class='body-md'>{content.description}</p>
    </div>
    <div class="w-[66%] h-auto aspect-909/512 overflow-hidden rounded-lg relative" >
      <img src="/images/fundador.webp" alt="Fundador" width="1672" height="941" decoding="async" loading="lazy" class='w-full h-full absolute object-cover inset-0' />
    </div>
  </div>
</section>
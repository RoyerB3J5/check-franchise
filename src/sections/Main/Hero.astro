---
import Button from "../../components/Button.astro";
type Translations = typeof import("../../i18n/en").default;
type HeroContent = Translations["main"]["hero"];
interface Props {
  content: HeroContent;
}
const { content} = Astro.props as Props;

// Comprueba si la URL coincide con la raíz o los prefijos de idioma (/ , /es, /es/, /en, /en/)
const locale = Astro.url.pathname.startsWith("/es") ? "/es" : "/en";
---
<section class='w-full h-[calc(100svh-80px)] md:h-[calc(100svh-80px)] relative flex items-center justify-center text-white ' >
  <img src="/images/hero-main.webp" alt="Hero image" decoding="async" loading="lazy" width="1920" height="974" class='w-full h-full object-cover inset-0 absolute z-0 object-top' />
  <div class="container-full flex flex-col justify-start items-start gap-6 md:gap-8 h-full py-10 md:py-12 relative z-5">
    <p class='body-small uppercase fade-up-lines'>{content.tag}</p>
    <h1 class='heading-1 max-w-[445px] text-start fade-up-lines-raw'>{content.title}</h1>
    <p class='body-md max-w-[419px] text-start fade-up-lines'>{content.description}</p>
    <div class='flex flex-col md:flex-row justify-center itmes-center gap-4 w-full md:w-auto'>
      <Button text={content.buttons[0].label} href={content.buttons[0].href} extraBtnClass="bg-accent shadow-[0_8px_0_0_#172514] fade-up-a" textClass="text-white" />
      <Button text={content.buttons[1].label} href={`${locale}${content.buttons[1].href}`} extraBtnClass="bg-white shadow-[0_8px_0_0_#A1A1A1] fade-up-a" textClass="text-accent"/>
    </div>
  </div>  
</section>

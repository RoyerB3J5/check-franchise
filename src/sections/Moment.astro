---
import Liston from "../components/Liston.astro";

type Translations = typeof import("../i18n/en").default;
type Content = Translations["franchiseBusiness"]["moment"];
interface Props {
  content: Content;
}
const { content} = Astro.props as Props;
const cardPositions = [
  "lg:col-start-2 lg:row-start-1",
  "lg:col-start-1 lg:row-start-2",
  "lg:col-start-3 lg:row-start-2",
];
---
<section data-moment-section class='w-full flex flex-col justify-center items-center relative z-5'>
  <Liston
    src="/images/decoration-l.webp"
    w={115} h={411}
    d="M -20 88 C 45 88, 125 180, 100 245 C 80 300, 45 348, -20 348"
    grosor={120}
    class="absolute top-[20%] xl:top-[10%] left-0 w-[90px] xl:w-[115px] h-auto"
  />
  <Liston src="/images/decoration-o-r.webp"w={284} h={656} grosor={230} d="M 360 190 C 335 177, 311 165, 284 150 C 257 135, 227 109, 200 100 C 173 91, 142 87, 120 95 C 98 103, 77 124, 70 150 C 63 176, 67 212, 80 250 C 93 288, 122 335, 150 380 C 178 425, 220 467, 250 520 C 280 573, 303 640, 330 700" class="absolute bottom-[-5%] right-0 w-[120px] xl:w-[153px] h-auto object-cover" />
  <div class='container-full grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 lg:grid-rows-3 gap-y-4 md:gap-y-10 xl:gap-y-20 gap-x-6 justify-center items-start py-14 md:py-20 xl:py-25'>
    <div class="w-full md:aspect-square flex flex-col justify-start items-start gap-8 text-paragraph lg:col-start-1 lg:row-start-1 mb-6 md:mb-0">
      <p class="subtitle uppercase fade-up-lines">{content.tag}</p>
      <h2 set:html={content.title} class='heading-1 fade-up-lines'></h2>
    </div>
    {
      content.items.map((item,index)=>( 
        <button
            type="button"
            class={`breakpoint-card bg-primary ${cardPositions[index] ?? ""} w-full flex flex-col justify-between items-start px-8 py-10 bg-[#F3F0E9] border-0 rounded-lg text-left h-auto aspect-443/300 md:aspect-443/470 xl:aspect-443/400`}
            aria-expanded="false"
            data-breakpoint-card
          >
            <p class='heading-1 self-end'>0{index + 1}</p>
            <div class="flex flex-col justify-center items-start text-paragraph">
              <h3 class='heading-3'>
                {item.title}
              </h3>
              <div class="breakpoint-card__details">
                <div class="w-10 h-0.75 bg-paragraph my-8"></div>
                <p class='body-md'>
                  {item.description}
                </p>
              </div>
            </div>
          </button>  
      ))
    }
    <button
      type="button"
      class='breakpoint-card breakpoint-card--static bg-[#F3F0E9] w-full h-auto aspect-443/300 md:aspect-443/400 overflow-hidden rounded-lg relative py-10 px-8 flex flex-col justify-between items-start border-0 text-left lg:col-start-2 lg:row-start-3'
    >
      <span class="relative self-end w-6 h-6" aria-hidden="true">
        <img src='/icons/check.svg' alt="" width="24" height="24" decoding="async" loading="lazy" class='breakpoint-card__icon absolute inset-0'/>
      </span>
      <p class='body-md'>
                  {content.description}
      </p>
    </button>
  </div>
</section>
<script>
  const cards = document.querySelectorAll<HTMLButtonElement>("[data-moment-section] [data-breakpoint-card]");

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const isExpanded = card.getAttribute("aria-expanded") === "true";
      card.setAttribute("aria-expanded", String(!isExpanded));
      card.classList.toggle("is-active", !isExpanded);
    });
  });
</script>

<style>
  .breakpoint-card {
    background-color: #f3f0e9;
    transition:
      background-color 400ms ease-in-out,
      color 300ms ease-in-out;
  }

  .breakpoint-card__details {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding-bottom: 0.25rem;
    transform: translateY(0.75rem);
    transition:
      max-height 400ms ease-in-out,
      opacity 300ms ease-in-out,
      transform 400ms ease-in-out;
  }

  .breakpoint-card__icon--back {
    transform: scale(0.8);
  }

  .breakpoint-card.bg-primary.is-active {
    background-color: var(--color-primary);
  }

  .breakpoint-card.bg-secondary.is-active {
    background-color: var(--color-secondary);
  }

  .breakpoint-card.bg-third.is-active {
    background-color: var(--color-third);
  }

  .breakpoint-card.is-active {
    color: var(--color-paragraph);
  }

  .breakpoint-card.is-active .breakpoint-card__details {
    max-height: 12rem;
    opacity: 1;
    transform: translateY(0);
  }

  .breakpoint-card.is-active .breakpoint-card__icon:not(.breakpoint-card__icon--back) {
    opacity: 0;
    transform: scale(0.8);
  }

  .breakpoint-card.is-active .breakpoint-card__icon--back {
    opacity: 1;
    transform: scale(1);
  }

  .breakpoint-card.breakpoint-card--static,
  .breakpoint-card.breakpoint-card--static:hover,
  .breakpoint-card.breakpoint-card--static:active,
  .breakpoint-card.breakpoint-card--static:focus {
    background-color: #f3f0e9;
    color: inherit;
    transition: none;
  }

  @media (min-width: 1024px) {
    .breakpoint-card.bg-primary:hover {
      background-color: var(--color-primary);
    }

    .breakpoint-card.bg-secondary:hover {
      background-color: var(--color-secondary);
    }

    .breakpoint-card.bg-third:hover {
      background-color: var(--color-third);
    }

    .breakpoint-card:hover {
      color: var(--color-paragraph);
    }

    .breakpoint-card:hover .breakpoint-card__details {
      max-height: 12rem;
      opacity: 1;
      transform: translateY(0);
    }

    .breakpoint-card:hover .breakpoint-card__icon:not(.breakpoint-card__icon--back) {
      opacity: 0;
      transform: scale(0.8);
    }

    .breakpoint-card:hover .breakpoint-card__icon--back {
      opacity: 1;
      transform: scale(1);
    }

  }

  .breakpoint-card.breakpoint-card--static:hover,
  .breakpoint-card.breakpoint-card--static:active,
  .breakpoint-card.breakpoint-card--static:focus,
  .breakpoint-card.breakpoint-card--static:focus-visible {
    background-color: #f3f0e9;
    color: inherit;
  }

  .breakpoint-card.breakpoint-card--static:hover .breakpoint-card__icon,
  .breakpoint-card.breakpoint-card--static:active .breakpoint-card__icon,
  .breakpoint-card.breakpoint-card--static:focus .breakpoint-card__icon,
  .breakpoint-card.breakpoint-card--static:focus-visible .breakpoint-card__icon {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .breakpoint-card,
    .breakpoint-card__details,
    .breakpoint-card__icon {
      transition-duration: 0.01ms;
    }
  }
</style>
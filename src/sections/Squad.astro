 ---
import Liston from "../components/Liston.astro";
import FounderContent from "./FounderContent.astro";

type Translations = typeof import("../i18n/en").default;
type Content = Translations["us"]["team"];
interface Props {
  content: Content;
  contentFounder: Translations["main"]["founder"];
}
const { content, contentFounder } = Astro.props as Props;
---
<section class="w-full flex flex-col justify-center items-center py-14 md:py-20 xl:py-25 gap-10 relative">
  <Liston src="/images/decoration-o-r.webp" w={284} h={656} grosor={230} d="M 330 700 C 303 640, 280 573, 250 520 C 220 467, 178 425, 150 380 C 122 335, 93 288, 80 250 C 67 212, 63 176, 70 150 C 77 124, 98 103, 120 95 C 142 87, 173 91, 200 100 C 227 109, 257 135, 284 150 C 311 165, 335 177, 360 190" class="absolute top-[3%] right-0 w-[113px] h-auto object-cover z-11" />
  <h2 set:html={content.title} class='heading-1 text-center fade-up-lines'></h2>
  <FounderContent content={contentFounder} />
  <div class='container-full grid grid-cols-4 justify-center items-stretch gap-6'>
    {
      content.members.map((member,index)=>(
        <div class='bg-[#F3F0E9] flex flex-col justify-center items-center gap-6 rounded-lg fade-up-a'>
          <div class='w-full h-auto aspect-158/201 rounded-lg overflow-hidden relative'>
            <img src={`/images/${member.img}.webp`} alt={member.title} width="1092" height="1440" decoding="async" loading="lazy" class='w-full h-full object-cover absolute inset-0'/>
          </div>
          <div class="flex flex-col justify-center items-start gap-4 px-4 pb-4 text-paragraph w-full">
            <h3 class='body-lg fade-up-lines'>{member.title}</h3>
            <p class='body-md fade-up-lines'>{member.description}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
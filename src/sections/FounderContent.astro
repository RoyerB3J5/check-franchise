---
type Translations = typeof import("../i18n/en").default;
type Content = Translations["main"]["founder"];
interface Props {
  content: Content;
}
const { content} = Astro.props as Props;
---
<div class='container-full flex flex-col md:flex-row justify-center items-stretch gap-0 md:gap-6 relative'>
    <div class="founder-content-card w-full md:w-[34%] flex flex-col justify-end items-start text-white p-8 rounded-lg bg-accent">
      <img src="/icons/person.svg" alt="Icono de Persona" width="30" height="24" decoding="async" loading="lazy" class='w-[30px] h-auto self-end mb-auto'/>
      <div class="founder-content-card__main flex flex-col justify-center items-start gap-6">
        <p class="uppercase body-sm fade-up-lines">{content.tag}</p>
        <h2 class="heading-3 text-secondary fade-up-lines">Esdras Ribeiro</h2>
        <p class='body-md tracking-[0.64px] fade-up-lines'>{content.subtitle}</p>
        <div class="w-10 h-[3px] bg-white "></div>
        <p class="body-md  fade-up-lines">{content.description}</p>
      </div>
    </div>
    <div class="w-full md:w-[66%] h-auto aspect-398/506 md:aspect-909/512 overflow-hidden rounded-lg relative fade-left-a -translate-y-3 md:translate-y-0" data-animation-threshold="0.55" >
      <img src="/images/fundador.webp" alt="Fundador" width="1672" height="941" decoding="async" loading="lazy" class='w-full h-full absolute object-[59%_50%] md:object-center object-cover inset-0' />
    </div>
  </div>

<style>
  .founder-content-card__description {
    display: grid;
    width: 100%;
    grid-template-rows: minmax(0, 1fr);
  }

  .founder-content-card__description-inner {
    min-height: 0;
    overflow: hidden;
  }

  .founder-content-card__description-text {
    text-box: normal;
    opacity: 1;
  }

  @media (max-width: 767px) {
    .founder-content-card {
      height: 379px;
      justify-content: space-between;
    }

    .founder-content-card__main {
      margin-top: auto;
    }

    .founder-content-card > img {
      margin-bottom: 0;
    }
  }

</style>

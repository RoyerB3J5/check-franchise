---
type Translations = typeof import("../i18n/en").default;
type Content = Translations["franchiseBusiness"]["company"];
interface Props {
  content: Content;
}
const { content} = Astro.props as Props;
---
<section class='w-full flex flex-col justify-center items-center relative bg-[#F3F0E9]'>
  <img src="/images/decoration-o-l.webp" alt="Decoration" class="absolute bottom-[-10%] left-0 w-[145px] h-auto object-cover z-5" width="145" height="400" decoding="async" loading="lazy"/>
  <div class='container-full flex justify-between items-start py-25'>
    <h2 class='body-xl max-w-[326px] text-paragraph'>{content.tag}</h2>
    <div class="flex justify-center items-center gap-3">
      <div class='flex flex-col justify-center items-start gap-14'>
        {
          content.list.map((item)=>(
            <p class='heading-3 text-primary' set:html={item}></p>
          ))
        }
      </div>
      <div class='flex flex-col justify-center items-center gap-2'>
        <img src="/icons/arrow-up.svg" alt="Arrow up" class="w-10 h-10"/>
        <img src="/icons/arrow-up.svg" alt="Arrow up" class="w-10 h-10 rotate-180"/>
      </div>
    </div>
  </div>
</section>